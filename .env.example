# Copy this file to .env and fill in your real tokens.
# .env is listed in .gitignore and will never be committed.

# Your Discord bot token (from discord.com/developers/applications → Bot → Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Your GitHub personal access token (from github.com/settings/tokens)
# No special scopes needed for public data; an unscoped token raises the rate limit
# from 60 req/hr (unauthenticated) to 5,000 req/hr and enables /github stats.
GITHUB_TOKEN=your_github_personal_access_token_here
